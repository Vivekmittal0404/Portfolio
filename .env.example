# MongoDB Atlas connection string. Restrict the database user to this app's database.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/portfolio?retryWrites=true&w=majority

# Single admin account. Generate the password hash with: npm run admin:hash
# The command prints escaped $ separators for local env-file compatibility.
ADMIN_EMAIL=you@example.com
ADMIN_DISPLAY_NAME=Portfolio Admin
ADMIN_PASSWORD_HASH=

# Generate 32+ random bytes for signing secure admin sessions.
ADMIN_SESSION_SECRET=

# Optional. Rotate the key currently exposed in the old client-side form before setting this.
WEB3FORMS_ACCESS_KEY=
